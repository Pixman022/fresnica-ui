            "color-yellow": { "$value": "{semantic.color.accent-yellow}", "$type": "color" },
            "color-yellow-container": { "$value": "{semantic.color.accent-yellow-container}", "$type": "color" },
            "color-orange": { "$value": "{semantic.color.accent-orange}", "$type": "color" },
            "color-orange-container": { "$value": "{semantic.color.accent-orange-container}", "$type": "color" }
        }
    },
    "compatibility": {
        "source": "src/styles/themes/default.less",
        "runtimeThemeVariables": "--Fresnica-*",
        "policy": "Keep existing public variables as compatibility aliases; do not remove or rename in the first migration."
    }
}
