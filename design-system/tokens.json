            "option-height": { "$value": "44px", "$type": "dimension" },
            "option-padding-x": { "$value": "{primitive.space.md}", "$type": "dimension" },
            "option-radius": { "$value": "{primitive.radius.sm}", "$type": "dimension" },
            "option-hover-background": { "$value": "{semantic.color.action-primary-container}", "$type": "color" },
            "option-active-background": { "$value": "{semantic.color.action-primary}", "$type": "color" },
            "option-active-content": { "$value": "{semantic.color.content-on-primary}", "$type": "color" }
        },
        "drawer": {
            "overlay": { "$value": "{semantic.color.overlay-scrim}", "$type": "color" },
            "background": { "$value": "{semantic.color.surface-default}", "$type": "color" },
            "content": { "$value": "{semantic.color.content-primary}", "$type": "color" },
            "border": { "$value": "{semantic.color.border-default}", "$type": "color" },
            "shadow": { "$value": "{primitive.shadow.base}", "$type": "shadow" },
            "radius": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
            "header-padding": { "$value": "{primitive.space.xl}", "$type": "dimension" },
            "body-padding": { "$value": "{primitive.space.xl}", "$type": "dimension" },
