{
    "$schema": "https://design-tokens.github.io/community-group/format/",
    "name": "Fresnica UI design tokens",
    "version": "1.0.0",
    "description": "Three-layer design tokens mapped to the existing Fresnica CSS custom properties.",
    "primitive": {
        "color": {
            "brand-primary": { "$value": "#00a875", "$type": "color" },
            "brand-primary-hover": { "$value": "#00ca8a", "$type": "color" },
            "brand-primary-active": { "$value": "#008f65", "$type": "color" },
            "brand-primary-container": { "$value": "#d4f7e9", "$type": "color" },
            "accent-purple": { "$value": "#6956c8", "$type": "color" },
            "accent-blue": { "$value": "#356ae6", "$type": "color" },
            "accent-orange": { "$value": "#c96a16", "$type": "color" },
            "accent-yellow": { "$value": "#a87500", "$type": "color" },
            "text-primary": { "$value": "#1a1c1d", "$type": "color" },
            "text-secondary": { "$value": "#3f4942", "$type": "color" },
            "text-disabled": { "$value": "#8a948e", "$type": "color" },
            "border-default": { "$value": "#e3e3e5", "$type": "color" },
            "border-light": { "$value": "#edeef0", "$type": "color" },
            "background": { "$value": "#f9f9fb", "$type": "color" },
            "background-secondary": { "$value": "#f3f3f5", "$type": "color" },
            "primary-container": { "$value": "#d4f7e9", "$type": "color" },
            "error": { "$value": "#c73945", "$type": "color" },
            "error-hover": { "$value": "#dd5662", "$type": "color" }
        },
        "font": {
            "family-base": {
                "$value": "Roboto, 'Noto Sans SC', -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif",
                "$type": "fontFamily"
            },
            "family-mono": {
                "$value": "'SF Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace",
                "$type": "fontFamily"
            },
            "size-caption": { "$value": "11px", "$type": "dimension" },
            "size-sm": { "$value": "12px", "$type": "dimension" },
            "size-supporting": { "$value": "13px", "$type": "dimension" },
            "size-base": { "$value": "14px", "$type": "dimension" },
            "size-action": { "$value": "15px", "$type": "dimension" },
            "size-lg": { "$value": "16px", "$type": "dimension" },
            "size-section-title": { "$value": "18px", "$type": "dimension" },
            "size-screen-title": { "$value": "20px", "$type": "dimension" },
            "size-title-lg": { "$value": "28px", "$type": "dimension" },
            "size-amount": { "$value": "32px", "$type": "dimension" },
            "size-display": { "$value": "48px", "$type": "dimension" },
            "weight-regular": { "$value": 400, "$type": "fontWeight" },
            "weight-medium": { "$value": 500, "$type": "fontWeight" },
            "weight-semibold": { "$value": 600, "$type": "fontWeight" },
            "weight-bold": { "$value": 700, "$type": "fontWeight" },
            "line-height-base": { "$value": 1.5715, "$type": "number" }
        },
        "space": {
            "xs": { "$value": "4px", "$type": "dimension" },
            "sm": { "$value": "8px", "$type": "dimension" },
            "md": { "$value": "12px", "$type": "dimension" },
            "lg": { "$value": "16px", "$type": "dimension" },
            "xl": { "$value": "24px", "$type": "dimension" }
        },
        "radius": {
            "sm": { "$value": "8px", "$type": "dimension" },
            "control": { "$value": "12px", "$type": "dimension" },
            "base": { "$value": "16px", "$type": "dimension" },
            "lg": { "$value": "24px", "$type": "dimension" },
            "pill": { "$value": "9999px", "$type": "dimension" }
        },
        "size": {
            "control-sm": { "$value": "32px", "$type": "dimension" },
            "control-compact": { "$value": "36px", "$type": "dimension" },
            "control-base": { "$value": "48px", "$type": "dimension" },
            "control-emphasis": { "$value": "52px", "$type": "dimension" },
            "control-lg": { "$value": "56px", "$type": "dimension" }
        },
        "border": {
            "width-default": { "$value": "1px", "$type": "dimension" }
        },
        "motion": {
            "duration-fast": { "$value": "0.15s", "$type": "duration" },
            "duration-base": { "$value": "0.25s", "$type": "duration" },
            "duration-slow": { "$value": "0.35s", "$type": "duration" },
            "ease-standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" }
        },
        "shadow": {
            "base": { "$value": "none", "$type": "shadow" }
        }
