    "component": {
        "button": {
            "primary-background": { "$value": "{semantic.color.action-primary}", "$type": "color" },
            "primary-background-hover": { "$value": "{semantic.color.action-primary-hover}", "$type": "color" },
            "primary-background-pressed": { "$value": "{semantic.color.action-primary-pressed}", "$type": "color" },
            "primary-content": { "$value": "{semantic.color.content-on-primary}", "$type": "color" },
            "height": { "$value": "{primitive.size.control-base}", "$type": "dimension" },
            "height-sm": { "$value": "{primitive.size.control-sm}", "$type": "dimension" },
            "height-lg": { "$value": "{primitive.size.control-lg}", "$type": "dimension" },
            "radius": { "$value": "{primitive.radius.base}", "$type": "dimension" },
            "padding-x": { "$value": "{primitive.space.lg}", "$type": "dimension" },
            "transition-duration": { "$value": "{semantic.motion.duration-base}", "$type": "duration" }
        },
        "input": {
            "background": { "$value": "{semantic.color.surface-default}", "$type": "color" },
            "content": { "$value": "{semantic.color.content-primary}", "$type": "color" },
            "placeholder": { "$value": "{semantic.color.content-disabled}", "$type": "color" },
            "border": { "$value": "{semantic.color.border-default}", "$type": "color" },
            "focus-border": { "$value": "{semantic.color.focus-ring}", "$type": "color" },
            "height": { "$value": "{primitive.size.control-base}", "$type": "dimension" },
            "radius": { "$value": "{primitive.radius.base}", "$type": "dimension" },
            "padding-x": { "$value": "{primitive.space.lg}", "$type": "dimension" }
        },
        "card": {
            "background": { "$value": "{semantic.color.surface-default}", "$type": "color" },
            "content": { "$value": "{semantic.color.content-primary}", "$type": "color" },
            "border": { "$value": "{semantic.color.border-light}", "$type": "color" },
            "radius": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
            "padding": { "$value": "{primitive.space.lg}", "$type": "dimension" },
            "shadow": { "$value": "{primitive.shadow.base}", "$type": "shadow" }
        },
        "dialog": {
            "background": { "$value": "{semantic.color.surface-default}", "$type": "color" },
            "content": { "$value": "{semantic.color.content-primary}", "$type": "color" },
            "border": { "$value": "{semantic.color.border-default}", "$type": "color" },
            "overlay": { "$value": "{semantic.color.overlay-scrim}", "$type": "color" },
            "radius": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
            "padding": { "$value": "{primitive.space.xl}", "$type": "dimension" }
        },
        "select": {
            "trigger-background": { "$value": "{semantic.color.surface-default}", "$type": "color" },
            "trigger-background-hover": { "$value": "{semantic.color.surface-raised}", "$type": "color" },
            "trigger-content": { "$value": "{semantic.color.content-primary}", "$type": "color" },
            "trigger-placeholder": { "$value": "{semantic.color.content-muted}", "$type": "color" },
            "trigger-border": { "$value": "{semantic.color.border-default}", "$type": "color" },
            "trigger-border-active": { "$value": "{semantic.color.action-primary}", "$type": "color" },
            "height": { "$value": "{primitive.size.control-base}", "$type": "dimension" },
            "radius": { "$value": "{primitive.radius.base}", "$type": "dimension" },
            "padding-x": { "$value": "{primitive.space.lg}", "$type": "dimension" },
            "gap": { "$value": "{primitive.space.md}", "$type": "dimension" },
