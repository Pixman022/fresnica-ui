            "surface-low": { "$value": "var(--Fresnica-surface-low)", "$type": "color" },
            "surface-raised": { "$value": "var(--Fresnica-surface-high)", "$type": "color" },
            "surface-highest": { "$value": "var(--Fresnica-surface-highest)", "$type": "color" },
            "surface-inverse": { "$value": "var(--Fresnica-inverse-color)", "$type": "color" },
            "surface-inverse-hover": { "$value": "var(--Fresnica-inverse-color-hover)", "$type": "color" },
            "surface-inverse-pressed": { "$value": "var(--Fresnica-inverse-color-active)", "$type": "color" },
            "content-primary": { "$value": "var(--Fresnica-text-color)", "$type": "color" },
            "content-secondary": { "$value": "var(--Fresnica-text-color-secondary)", "$type": "color" },
            "content-muted": { "$value": "var(--Fresnica-text-color-muted)", "$type": "color" },
            "content-disabled": { "$value": "var(--Fresnica-text-color-disabled)", "$type": "color" },
            "content-on-primary": { "$value": "var(--Fresnica-on-primary-color)", "$type": "color" },
            "content-on-primary-container": {
                "$value": "var(--Fresnica-on-primary-container-color)",
                "$type": "color"
            },
            "content-on-inverse": { "$value": "var(--Fresnica-on-inverse-color)", "$type": "color" },
            "content-on-success-container": {
                "$value": "var(--Fresnica-on-success-container-color)",
                "$type": "color"
            },
            "content-on-failure-container": {
                "$value": "var(--Fresnica-on-failure-container-color)",
                "$type": "color"
            },
            "content-on-warning-container": {
                "$value": "var(--Fresnica-on-warning-container-color)",
                "$type": "color"
            },
            "content-on-gain-container": { "$value": "var(--Fresnica-on-gain-container-color)", "$type": "color" },
            "content-on-loss-container": { "$value": "var(--Fresnica-on-loss-container-color)", "$type": "color" },
            "content-on-risk-high-container": {
                "$value": "var(--Fresnica-on-risk-high-container-color)",
                "$type": "color"
            },
            "border-default": { "$value": "var(--Fresnica-border-color)", "$type": "color" },
            "border-light": { "$value": "var(--Fresnica-border-color-light)", "$type": "color" },
            "border-subtle": { "$value": "var(--Fresnica-border-color-subtle)", "$type": "color" },
            "border-strong": { "$value": "var(--Fresnica-border-color-hover)", "$type": "color" },
            "action-primary": { "$value": "var(--Fresnica-primary-color)", "$type": "color" },
            "action-primary-hover": { "$value": "var(--Fresnica-primary-color-hover)", "$type": "color" },
            "action-primary-pressed": { "$value": "var(--Fresnica-primary-color-active)", "$type": "color" },
            "action-primary-container": { "$value": "var(--Fresnica-primary-color-bg)", "$type": "color" },
            "content-muted-strong": { "$value": "var(--Fresnica-text-color-muted)", "$type": "color" },
            "content-on-error": { "$value": "var(--Fresnica-on-error-color)", "$type": "color" },
            "state-disabled-background": { "$value": "var(--Fresnica-bg-color-disabled)", "$type": "color" },
            "accent-purple": { "$value": "var(--Fresnica-accent-purple-color)", "$type": "color" },
            "accent-purple-container": { "$value": "var(--Fresnica-accent-purple-color-bg)", "$type": "color" },
            "accent-blue": { "$value": "var(--Fresnica-accent-blue-color)", "$type": "color" },
            "accent-blue-container": { "$value": "var(--Fresnica-accent-blue-color-bg)", "$type": "color" },
            "accent-yellow": { "$value": "var(--Fresnica-accent-yellow-color)", "$type": "color" },
            "accent-yellow-container": { "$value": "var(--Fresnica-accent-yellow-color-bg)", "$type": "color" },
            "accent-orange": { "$value": "var(--Fresnica-accent-orange-color)", "$type": "color" },
            "accent-orange-container": { "$value": "var(--Fresnica-accent-orange-color-bg)", "$type": "color" },
            "feedback-error-hover": { "$value": "var(--Fresnica-error-color-hover)", "$type": "color" },
            "feedback-error-pressed": { "$value": "var(--Fresnica-error-color-active)", "$type": "color" },
            "feedback-success": { "$value": "var(--Fresnica-success-color)", "$type": "color" },
            "feedback-success-container": { "$value": "var(--Fresnica-success-color-bg)", "$type": "color" },
            "feedback-error": { "$value": "var(--Fresnica-error-color)", "$type": "color" },
            "feedback-failure": { "$value": "var(--Fresnica-failure-color)", "$type": "color" },
            "feedback-failure-container": { "$value": "var(--Fresnica-failure-color-bg)", "$type": "color" },
            "feedback-warning": { "$value": "var(--Fresnica-warning-color)", "$type": "color" },
            "feedback-warning-container": { "$value": "var(--Fresnica-warning-color-bg)", "$type": "color" },
            "status-gain": { "$value": "var(--Fresnica-gain-color)", "$type": "color" },
            "status-gain-container": { "$value": "var(--Fresnica-gain-color-bg)", "$type": "color" },
            "status-loss": { "$value": "var(--Fresnica-loss-color)", "$type": "color" },
            "status-loss-container": { "$value": "var(--Fresnica-loss-color-bg)", "$type": "color" },
            "risk-high": { "$value": "var(--Fresnica-risk-high-color)", "$type": "color" },
            "risk-high-container": { "$value": "var(--Fresnica-risk-high-color-bg)", "$type": "color" },
            "focus-ring": { "$value": "var(--Fresnica-focus-color)", "$type": "color" },
            "overlay-scrim": { "$value": "var(--Fresnica-mask-bg)", "$type": "color" }
        },
        "motion": {
            "duration-fast": { "$value": "var(--Fresnica-motion-duration-fast)", "$type": "duration" },
            "duration-base": { "$value": "var(--Fresnica-motion-duration-base)", "$type": "duration" },
            "duration-slow": { "$value": "var(--Fresnica-motion-duration-slow)", "$type": "duration" },
            "ease-standard": { "$value": "var(--Fresnica-motion-ease)", "$type": "cubicBezier" }
        }
