            "background": { "$value": "{semantic.color.surface-default}", "$type": "color" },
            "border": { "$value": "{semantic.color.border-subtle}", "$type": "color" },
            "radius": { "$value": "{primitive.radius.base}", "$type": "dimension" },
            "padding": { "$value": "{primitive.space.sm}", "$type": "dimension" },
            "header-background": { "$value": "{semantic.color.surface-raised}", "$type": "color" },
            "header-content": { "$value": "{semantic.color.content-secondary}", "$type": "color" },
            "row-background": { "$value": "{semantic.color.surface-default}", "$type": "color" },
            "row-hover-background": {
                "$value": "color-mix(in srgb, {semantic.color.action-primary} 10%, transparent)",
                "$type": "color"
            },
            "row-striped-background": { "$value": "{semantic.color.surface-low}", "$type": "color" },
            "cell-content": { "$value": "{semantic.color.content-secondary}", "$type": "color" },
            "cell-padding-x": { "$value": "{primitive.space.xl}", "$type": "dimension" },
            "cell-padding-y": { "$value": "{primitive.space.lg}", "$type": "dimension" },
            "empty-content": { "$value": "{semantic.color.content-muted}", "$type": "color" },
